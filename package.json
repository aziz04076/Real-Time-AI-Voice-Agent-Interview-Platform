{
  "name": "prepwise-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "test:db": "cd frontend && node ../backend/test-db.mjs",
    "test:conn": "cd frontend && node ../backend/test-conn.mjs",
    "test:port": "cd frontend && node ../backend/test-port.mjs",
    "debug:auth": "cd frontend && node ../backend/debug-auth.mjs"
  }
}
