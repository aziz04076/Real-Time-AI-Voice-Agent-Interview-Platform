# AI Services (Primary)
OPENAI_API_KEY=your_openai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# App
NEXT_PUBLIC_BASE_URL=http://localhost:4000

# Database Connection
# Option A: MongoDB Atlas SRV (Recommended for production)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/prepwise?appName=Cluster0

# Option B: Local MongoDB
MONGODB_URI=mongodb://localhost:27017/prepwise

# JWT Secret (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

# Vapi Integration (Optional)
NEXT_PUBLIC_VAPI_WEB_TOKEN=
NEXT_PUBLIC_VAPI_WORKFLOW_ID=
